{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["vite/client"],
		// Each route's `./+types/<route>` lives in the types `react-router
		// typegen` writes, which this lines up with `app/`.
		"rootDirs": [".", "./.react-router/types"]
	},
	"include": [".", ".react-router/types/**/*"]
}
